// ============================================================================
// Prisma Schema for FAFAB Limited - Bahria Town, Lahore, Pakistan
// Accounting & HR ERP System
// Compliant with: FBR (Federal Board of Revenue), PRA (Punjab Revenue Authority),
// PESSI (Punjab Employees' Social Security Institution), and EOBI.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS & CONSTANTS
// ----------------------------------------------------------------------------

enum UserRole {
  ADMIN
  HR_MANAGER
  ACCOUNTANT
  EMPLOYEE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  PROBATION
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
  SUSPENDED
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  ON_LEAVE
  HOLIDAY
}

enum LeaveType {
  CASUAL
  SICK
  ANNUAL
  MATERNITY
  HAJJ
  UNPAID
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  PAY_ORDER
  RAAST_INSTANT_PAYMENT
  ONLINE_PORTAL
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  UNDER_REPAIR
  DECOMMISSIONED
  LOST
}

enum TaxFilerStatus {
  ACTIVE_FILER
  NON_FILER
  EXEMPT
}

// ----------------------------------------------------------------------------
// 1. CORE & USER MANAGEMENT
// ----------------------------------------------------------------------------

model CompanyProfile {
  id               String   @id @default(uuid())
  legalName        String   @default("FAFAB Limited")
  tradeName        String?  @default("FAFAB")
  registrationNo   String   @unique // SECP Registration Number
  ntnNumber        String   @unique // National Tax Number (FBR)
  strnNumber       String   @unique // Sales Tax Registration Number
  praRegNumber     String   @unique // Punjab Revenue Authority Registration
  eobiRegNumber    String?  // EOBI Employer Registration
  pessiRegNumber   String?  // PESSI Employer Registration
  
  // Location & Contacts
  officeAddress    String   @default("Plot 12-A, Commercial Area, Sector C, Bahria Town")
  city             String   @default("Lahore")
  province         String   @default("Punjab")
  country          String   @default("Pakistan")
  postalCode       String   @default("53720")
  officialEmail    String   @default("info@fafablimited.pk")
  officialPhone    String   @default("+92 42 37861122")
  websiteUrl       String?  @default("https://fafablimited.pk")

  currency         String   @default("PKR")
  fiscalYearStart  Int      @default(7)  // July (Pakistan Fiscal Year: July-June)
  fiscalYearEnd    Int      @default(6)  // June

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  passwordHash  String
  name          String
  role          UserRole     @default(EMPLOYEE)
  isActive      Boolean      @default(true)
  avatarUrl     String?
  
  // Link to Employee Record (if employee)
  employeeId    String?      @unique
  employee      Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  // Audit Trails
  auditLogs     AuditLog[]
  createdInvoices Invoice[]  @relation("InvoiceCreatedBy")
  approvedLeaves  LeaveRequest[] @relation("LeaveApprovedBy")

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([role])
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   // e.g., "CREATE_INVOICE", "RUN_PAYROLL", "APPROVE_LEAVE"
  module      String   // "ACCOUNTING", "HR", "PAYROLL", "ASSETS"
  targetId    String?  // Record ID being affected
  ipAddress   String?
  details     Json?    // Snapshot of previous vs new state
  createdAt   DateTime @default(now())

  @@index([userId, module])
  @@index([createdAt])
}

// ----------------------------------------------------------------------------
// 2. HUMAN RESOURCE MANAGEMENT (HRM)
// ----------------------------------------------------------------------------

model Department {
  id          String       @id @default(uuid())
  code        String       @unique // e.g. "ENG", "FIN", "HR", "OPS"
  name        String
  description String?
  headId      String?      // Employee ID of Department Head
  employees   Employee[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Designation {
  id          String       @id @default(uuid())
  title       String       @unique // e.g. "Senior Accountant", "Full Stack Engineer"
  gradeLevel  String?      // e.g. "L4", "Executive"
  departmentId String?
  employees   Employee[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Employee {
  id               String          @id @default(uuid())
  employeeCode     String          @unique // e.g., "FAFAB-EMP-001"
  firstName        String
  lastName         String
  urduName         String?         // Full name in Urdu Nastaliq
  
  // National Identification & Compliance
  cnicNumber       String          @unique // Format: 35201-XXXXXXX-X (Lahore / Punjab)
  cnicExpiryDate   DateTime?
  dateOfBirth      DateTime
  gender           String          // Male, Female, Other
  bloodGroup       String?
  maritalStatus    String?

  // Contact & Lahore Local Residence
  personalEmail    String          @unique
  workEmail        String?         @unique
  phoneNumber      String          // e.g., 0300-1234567
  emergencyContact String?         // Emergency Name & Phone
  residentialAddress String        // Street address, e.g., Sector B, Bahria Town, Lahore
  city             String          @default("Lahore")
  province         String          @default("Punjab")

  // Employment Details
  departmentId     String
  department       Department      @relation(fields: [departmentId], references: [id])
  designationId    String
  designation      Designation     @relation(fields: [designationId], references: [id])
  employmentType   EmploymentType  @default(FULL_TIME)
  employeeStatus   EmployeeStatus  @default(ACTIVE)
  dateOfJoining    DateTime
  probationEndDate DateTime?
  dateOfExit       DateTime?
  exitReason       String?

  // Social Security & Retirement Reg Numbers
  eobiNumber       String?         // Individual EOBI registration number
  pessiNumber      String?         // Individual PESSI card number
  ntnNumber        String?         // Individual NTN for salaried tax filing
  taxFilerStatus   TaxFilerStatus  @default(ACTIVE_FILER)

  // Salary Bank Account for Direct Payroll Transfer
  bankName         String?         // e.g., "Meezan Bank", "HBL", "MCB"
  bankBranch       String?         // e.g., "Bahria Town Lahore Branch"
  bankAccountNumber String?
  iban             String?         // PK##MEZN0000000000000000

  // Relations
  userAccount      User?
  salaryStructure  SalaryStructure?
  payrollRecords   PayrollRecord[]
  attendances      Attendance[]
  leaveRequests    LeaveRequest[]
  assignedAssets   CompanyAsset[]

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([employeeCode])
  @@index([departmentId])
  @@index([employeeStatus])
}

// ----------------------------------------------------------------------------
// 3. PAYROLL & COMPENSATION (PAKISTANI STATUTORY COMPLIANCE)
// ----------------------------------------------------------------------------

model SalaryStructure {
  id                    String    @id @default(uuid())
  employeeId            String    @unique
  employee              Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Earnings Breakdown (in PKR)
  basicSalary           Decimal   @db.Decimal(12, 2) // Standard base (normally 50-60% of gross)
  houseRentAllowance    Decimal   @default(0) @db.Decimal(12, 2) // Typically 40-45% of Basic
  medicalAllowance      Decimal   @default(0) @db.Decimal(12, 2) // 10% tax exempt under clause 139
  conveyanceAllowance   Decimal   @default(0) @db.Decimal(12, 2)
  specialAllowance      Decimal   @default(0) @db.Decimal(12, 2)
  grossSalary           Decimal   @db.Decimal(12, 2) // Total monthly fixed package

  // Statutory Flags
  isEobiApplicable      Boolean   @default(true) // Punjab minimum wage statutory EOBI
  isPessiApplicable     Boolean   @default(true) // PESSI applicable if wage <= PESSI ceiling
  isTaxWithholding      Boolean   @default(true) // FBR Section 149 salaried income tax

  effectiveFrom         DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model PayrollPeriod {
  id             String          @id @default(uuid())
  periodName     String          // e.g. "October 2026", "November 2026"
  month          Int             // 1 - 12
  year           Int             // 2026
  startDate      DateTime
  endDate        DateTime
  status         PayrollStatus   @default(DRAFT)
  
  totalGross     Decimal         @default(0) @db.Decimal(14, 2)
  totalTaxDeducted Decimal       @default(0) @db.Decimal(14, 2)
  totalEobiEmployee Decimal      @default(0) @db.Decimal(14, 2)
  totalEobiEmployer Decimal      @default(0) @db.Decimal(14, 2)
  totalPessiEmployer Decimal     @default(0) @db.Decimal(14, 2)
  totalNetPayable Decimal        @default(0) @db.Decimal(14, 2)

  disbursementDate DateTime?
  records        PayrollRecord[]
  journalEntryId String?         // Link to automated double-entry ledger entry

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([month, year])
}

model PayrollRecord {
  id                    String        @id @default(uuid())
  payrollPeriodId       String
  payrollPeriod         PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employeeId            String
  employee              Employee      @relation(fields: [employeeId], references: [id])

  // Working Days & Attendance adjustments
  totalMonthDays        Int           @default(30)
  daysWorked            Decimal       @default(30) @db.Decimal(4, 1)
  unpaidLeaveDays       Decimal       @default(0) @db.Decimal(4, 1)

  // Earnings (PKR)
  basicSalary           Decimal       @db.Decimal(12, 2)
  houseRentAllowance    Decimal       @default(0) @db.Decimal(12, 2)
  medicalAllowance      Decimal       @default(0) @db.Decimal(12, 2)
  conveyanceAllowance   Decimal       @default(0) @db.Decimal(12, 2)
  overtimePay           Decimal       @default(0) @db.Decimal(12, 2)
  performanceBonus      Decimal       @default(0) @db.Decimal(12, 2)
  grossPay              Decimal       @db.Decimal(12, 2)

  // Pakistani Statutory Deductions (PKR)
  // EOBI: 1% employee contribution calculated on notified Punjab Minimum Wage
  eobiEmployeeDeduction Decimal       @default(0) @db.Decimal(10, 2)
  // EOBI: 5% employer contribution calculated on notified Punjab Minimum Wage
  eobiEmployerContribution Decimal    @default(0) @db.Decimal(10, 2)
  // PESSI: 6% employer contribution for employees within Punjab Social Security wage limit
  pessiEmployerContribution Decimal   @default(0) @db.Decimal(10, 2)
  // FBR Income Tax: Withheld under Section 149 based on annual progressive slabs
  incomeTaxWithheld     Decimal       @default(0) @db.Decimal(12, 2)
  
  // Other Deductions & Loan
  salaryAdvanceDeduction Decimal      @default(0) @db.Decimal(12, 2)
  unpaidLeaveDeduction  Decimal       @default(0) @db.Decimal(12, 2)
  totalDeductions       Decimal       @db.Decimal(12, 2)

  // Final Net Disbursement
  netPay                Decimal       @db.Decimal(12, 2)
  paymentStatus         PayrollStatus @default(DRAFT)
  paymentReference      String?       // Bank transfer transaction ID / Cheque #
  payslipGeneratedAt    DateTime?

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([payrollPeriodId, employeeId])
  @@index([employeeId])
}

// ----------------------------------------------------------------------------
// 4. ATTENDANCE & LEAVE MANAGEMENT
// ----------------------------------------------------------------------------

model Attendance {
  id          String           @id @default(uuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  status      AttendanceStatus @default(PRESENT)
  workHours   Decimal?         @db.Decimal(4, 2)
  notes       String?

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([date, status])
}

model LeaveRequest {
  id           String        @id @default(uuid())
  employeeId   String
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType     @default(CASUAL)
  startDate    DateTime      @db.Date
  endDate      DateTime      @db.Date
  totalDays    Decimal       @db.Decimal(4, 1)
  reason       String
  status       LeaveStatus   @default(PENDING)
  
  approverId   String?
  approver     User?         @relation("LeaveApprovedBy", fields: [approverId], references: [id])
  rejectionReason String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([employeeId, status])
}

// ----------------------------------------------------------------------------
// 5. ASSET MANAGEMENT
// ----------------------------------------------------------------------------

model CompanyAsset {
  id             String      @id @default(uuid())
  assetTag       String      @unique // e.g. "FAFAB-LPT-042", "FAFAB-MBL-007"
  title          String      // e.g. "Dell Latitude 5530 16GB"
  category       String      // Laptop, Mobile, Vehicle, Desktop, Monitor
  serialNumber   String?     @unique
  purchaseDate   DateTime?
  purchaseCost   Decimal?    @db.Decimal(12, 2) // in PKR
  status         AssetStatus @default(AVAILABLE)

  assignedToId   String?
  assignedTo     Employee?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedDate   DateTime?
  expectedReturn DateTime?
  specifications Json?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([assignedToId])
  @@index([status])
}

// ----------------------------------------------------------------------------
// 6. GENERAL LEDGER & CHART OF ACCOUNTS (DOUBLE-ENTRY ACCOUNTING)
// ----------------------------------------------------------------------------

model Account {
  id             String           @id @default(uuid())
  accountCode    String           @unique // e.g., "1010" (Cash), "1020" (Meezan Bank), "4010" (Service Revenue)
  accountName    String           // Descriptive Title
  accountType    AccountType
  category       String           // Current Asset, Fixed Asset, Current Liability, Operating Expense, etc.
  description    String?
  isActive       Boolean          @default(true)
  currentBalance Decimal          @default(0) @db.Decimal(14, 2)
  isReconciled   Boolean          @default(false)

  // Ledger line items
  journalLines   JournalLineItem[]
  bankAccounts   BankAccount[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([accountType, category])
}

model JournalEntry {
  id           String            @id @default(uuid())
  entryNumber  String            @unique // e.g., "JV-2026-00045"
  entryDate    DateTime          @db.Date
  memo         String            // Description / Narration
  referenceNo  String?           // External voucher / invoice / cheque ref
  isPosted     Boolean           @default(true)
  totalDebit   Decimal           @db.Decimal(14, 2)
  totalCredit  Decimal           @db.Decimal(14, 2)
  
  lines        JournalLineItem[]
  
  // Relations to source records
  invoiceId    String?
  expenseId    String?
  payrollId    String?

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([entryDate])
}

model JournalLineItem {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  
  description    String?
  debit          Decimal      @default(0) @db.Decimal(14, 2)
  credit         Decimal      @default(0) @db.Decimal(14, 2)

  createdAt      DateTime     @default(now())

  @@index([accountId])
  @@index([journalEntryId])
}

// ----------------------------------------------------------------------------
// 7. INVOICING & BILLING (FBR & PRA LOCALIZED)
// ----------------------------------------------------------------------------

model Customer {
  id             String          @id @default(uuid())
  customerCode   String          @unique // e.g., "CUST-001"
  companyName    String
  contactPerson  String?
  email          String?
  phone          String
  address        String          // e.g. Bahria Town / Gulberg / DHA Lahore
  city           String          @default("Lahore")
  province       String          @default("Punjab")
  country        String          @default("Pakistan")

  // Tax Profile (Pakistan)
  ntnNumber      String?         // Customer NTN
  strnNumber     String?         // Customer STRN (if registered with PRA/FBR)
  taxFilerStatus TaxFilerStatus  @default(ACTIVE_FILER)

  invoices       Invoice[]
  payments       Payment[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([companyName])
}

model Invoice {
  id                String          @id @default(uuid())
  invoiceNumber     String          @unique // e.g., "FAFAB-INV-2026-0104"
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id])
  
  issueDate         DateTime        @db.Date
  dueDate           DateTime        @db.Date
  status            InvoiceStatus   @default(DRAFT)

  // Currency & Amounts (PKR)
  subTotal          Decimal         @db.Decimal(14, 2) // Total before taxes & discounts
  discountAmount    Decimal         @default(0) @db.Decimal(14, 2)
  
  // Punjab Revenue Authority (PRA) Provincial Sales Tax on Services (Default 16%)
  praTaxRate        Decimal         @default(16.00) @db.Decimal(5, 2)
  praTaxAmount      Decimal         @default(0) @db.Decimal(14, 2)
  
  // FBR Withholding Tax on Services (Section 153 - e.g., 3% for Filers, higher for Non-Filers)
  withholdingTaxRate Decimal        @default(0) @db.Decimal(5, 2)
  withholdingTaxAmount Decimal      @default(0) @db.Decimal(14, 2)
  
  grandTotal        Decimal         @db.Decimal(14, 2) // Final invoiced amount
  amountPaid        Decimal         @default(0) @db.Decimal(14, 2)
  balanceDue        Decimal         @db.Decimal(14, 2)

  notes             String?
  paymentTerms      String?         @default("Net 15 Days. Please deposit into FAFAB Limited bank account.")
  
  createdById       String?
  createdBy         User?           @relation("InvoiceCreatedBy", fields: [createdById], references: [id])

  items             InvoiceItem[]
  payments          Payment[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([issueDate])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  description String   // Service / Product description
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(14, 2) // in PKR
  amount      Decimal  @db.Decimal(14, 2) // quantity * unitPrice
  praApplicable Boolean @default(true) // Whether 16% PRA applies to this line

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {
  id             String        @id @default(uuid())
  paymentNumber  String        @unique // e.g. "RCPT-2026-0042"
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  invoiceId      String?
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  paymentDate    DateTime      @db.Date
  amount         Decimal       @db.Decimal(14, 2)
  paymentMethod  PaymentMethod @default(BANK_TRANSFER)
  referenceNo    String?       // Cheque # or Bank Transaction reference
  bankAccountId  String?
  bankAccount    BankAccount?  @relation(fields: [bankAccountId], references: [id])

  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([customerId])
  @@index([invoiceId])
}

// ----------------------------------------------------------------------------
// 8. EXPENSES & VENDOR MANAGEMENT
// ----------------------------------------------------------------------------

model Vendor {
  id             String          @id @default(uuid())
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?         // Lahore locality
  ntnNumber      String?
  strnNumber     String?
  taxFilerStatus TaxFilerStatus  @default(ACTIVE_FILER)
  expenses       Expense[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ExpenseCategory {
  id          String    @id @default(uuid())
  name        String    @unique // e.g., "Office Rent - Bahria Town", "Electricity - LESCO", "Internet", "Fuel", "Office Supplies"
  code        String    @unique // e.g., "EXP-RENT", "EXP-UTIL"
  expenses    Expense[]
  createdAt   DateTime  @default(now())
}

model Expense {
  id            String          @id @default(uuid())
  expenseNumber String          @unique // e.g., "EXP-2026-0099"
  categoryId    String
  category      ExpenseCategory @relation(fields: [categoryId], references: [id])
  vendorId      String?
  vendor        Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  expenseDate   DateTime        @db.Date
  amount        Decimal         @db.Decimal(14, 2)
  salesTaxPaid  Decimal         @default(0) @db.Decimal(12, 2) // PRA or FBR input tax
  whtDeducted   Decimal         @default(0) @db.Decimal(12, 2) // Withholding tax retained
  netPaid       Decimal         @db.Decimal(14, 2)
  
  paymentMethod PaymentMethod   @default(BANK_TRANSFER)
  referenceNo   String?         // Cheque # or Raast receipt
  receiptUrl    String?         // Uploaded scanned receipt or bill
  description   String
  isReconciled  Boolean         @default(false)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([categoryId])
  @@index([expenseDate])
}

// ----------------------------------------------------------------------------
// 9. BANKING & CASH MANAGEMENT
// ----------------------------------------------------------------------------

model BankAccount {
  id             String        @id @default(uuid())
  accountTitle   String        // e.g. "FAFAB Limited - Operations Account"
  bankName       String        // e.g. "Meezan Bank Limited"
  branchName     String        // e.g. "Bahria Town Branch, Lahore"
  branchCode     String?       // e.g. "0219"
  accountNumber  String        @unique
  iban           String        @unique // e.g. "PK72MEZN0000000104889101"
  openingBalance Decimal       @default(0) @db.Decimal(14, 2)
  currentBalance Decimal       @default(0) @db.Decimal(14, 2)
  currency       String        @default("PKR")
  
  linkedAccountId String?      // Linked Chart of Accounts General Ledger code
  linkedAccount  Account?      @relation(fields: [linkedAccountId], references: [id])
  
  payments       Payment[]
  transactions   BankTransaction[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model BankTransaction {
  id            String        @id @default(uuid())
  bankAccountId String
  bankAccount   BankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  
  transactionDate DateTime    @db.Date
  description   String
  referenceNo   String?
  debit         Decimal       @default(0) @db.Decimal(14, 2) // Deposit into bank
  credit        Decimal       @default(0) @db.Decimal(14, 2) // Withdrawal / Cheque cleared
  runningBalance Decimal      @db.Decimal(14, 2)
  isReconciled  Boolean       @default(false)

  createdAt     DateTime      @default(now())

  @@index([bankAccountId, transactionDate])
}
